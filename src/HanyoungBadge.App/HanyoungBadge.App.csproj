<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HanyoungBadge.App</RootNamespace>
    <AssemblyName>HanyoungKeyRemap</AssemblyName>

    <!-- Version/FileVersion/AssemblyVersion 은 여기에 적지 않는다.
         저장소 루트 Directory.Build.props 가 루트 VERSION 파일에서 읽어 내려 준다. [SOO-28] -->

    <!-- 보더 제공 아이콘(assets/ico.ico, SHA256 2acd5926...). exe 리소스 + 바로가기 아이콘에 사용. -->
    <ApplicationIcon>..\..\assets\ico.ico</ApplicationIcon>

    <!-- Linux 에서 net8.0-windows/WinForms 를 크로스 컴파일하기 위해 필요 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- 단일 exe self-contained 배포 기본값 (publish 시 -r/-p 로도 지정) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HanyoungBadge.Core\HanyoungBadge.Core.csproj" />
  </ItemGroup>

</Project>
